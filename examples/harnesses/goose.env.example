# goose.env.example — export these in your shell or add to your goose config env
# Wire surface: OpenAI Chat Completions (default). Model ids are free-form.
OPENAI_BASE_URL=http://127.0.0.1:3457/v1
OPENAI_API_KEY=YOUR_KEY

# Anthropic-Messages alternative — host only; goose appends /v1/messages itself.
#ANTHROPIC_HOST=http://127.0.0.1:3457
#ANTHROPIC_API_KEY=YOUR_KEY

# Select the model in goose the usual way, e.g.:
#   goose --model deepseek/deepseek-v4-flash
