# aider.env.example — export these in your shell, or use the CLI flags below.
# Wire surface: OpenAI Chat Completions (via LiteLLM).
OPENAI_API_BASE=http://127.0.0.1:3457/v1
OPENAI_API_KEY=YOUR_KEY

# CLI equivalent:
#   aider --openai-api-base http://127.0.0.1:3457/v1 \
#         --openai-api-key YOUR_KEY --model deepseek/deepseek-v4-flash

# Aider's fast key validation picks the env var by model prefix: for a
# "deepseek/..." model id it checks DEEPSEEK_API_KEY. If you hit a missing-key
# error, set one of these instead:
#DEEPSEEK_API_KEY=YOUR_KEY
# or:  aider --api-key deepseek=YOUR_KEY ...
