# qwen.env.example — export these in your shell (or your qwen-code config env)
# Wire surface: OpenAI Chat Completions (USE_OPENAI).
USE_OPENAI=1
OPENAI_BASE_URL=http://127.0.0.1:3457/v1
OPENAI_API_KEY=YOUR_KEY
OPENAI_MODEL=deepseek/deepseek-v4-flash

# Anthropic-Messages alternative (proxy mode: Bearer token + x-app: cli).
# Host only — qwen-code appends /v1/messages.
#USE_ANTHROPIC=1
#ANTHROPIC_BASE_URL=http://127.0.0.1:3457
#ANTHROPIC_API_KEY=YOUR_KEY
#ANTHROPIC_MODEL=deepseek/deepseek-v4-flash
